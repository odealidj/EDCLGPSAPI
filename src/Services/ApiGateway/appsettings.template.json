{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "ReverseProxy": {
    "Routes": {
      "legacy-gps-lastposition-route": {
        "ClusterId": "position-query-cluster",
        "Order": 1,
        "Match": {
          "Path": "/gps-lastposition"
        }
      },
      "positions-route": {
        "ClusterId": "position-query-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/v1/positions/{**catch-all}"
        }
      },
      "vendors-route": {
        "ClusterId": "vendor-master-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/v1/vendors/{**catch-all}"
        }
      },
      "legacy-geofencemaster-route": {
        "ClusterId": "vendor-master-cluster",
        "Order": 3,
        "Match": {
          "Path": "/geofencemaster/{**catch-all}"
        }
      },
      "legacy-geofencemaster-exact-route": {
        "ClusterId": "vendor-master-cluster",
        "Order": 3,
        "Match": {
          "Path": "/geofencemaster"
        }
      },
      "deliveries-route": {
        "ClusterId": "delivery-tracking-cluster",
        "Order": 4,
        "Match": {
          "Path": "/api/v1/deliveries/{**catch-all}"
        }
      },
      "legacy-delivery-onprogress-route": {
        "ClusterId": "delivery-tracking-cluster",
        "Order": 4,
        "Match": {
          "Path": "/api/v1/RDeliveryOnProgress/{**catch-all}"
        }
      },
      "legacy-delivery-onprogress-exact-route": {
        "ClusterId": "delivery-tracking-cluster",
        "Order": 4,
        "Match": {
          "Path": "/api/v1/RDeliveryOnProgress"
        }
      },
      "legacy-track-delivery-route": {
        "ClusterId": "delivery-tracking-cluster",
        "Order": 4,
        "Match": {
          "Path": "/api/v1/gps-data-edcl/{**catch-all}"
        }
      },
      "legacy-fallback-route": {
        "ClusterId": "legacy-monolith-cluster",
        "Order": 100,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "position-query-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://position-query-svc.edcl-prod.svc.cluster.local:8080"
          }
        }
      },
      "vendor-master-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://vendor-master-svc.edcl-prod.svc.cluster.local:8080"
          }
        }
      },
      "delivery-tracking-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://delivery-tracking-svc.edcl-prod.svc.cluster.local:8080"
          }
        }
      },
      "legacy-monolith-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://gps-api-svc.edcl-prod.svc.cluster.local:80"
          }
        }
      }
    }
  }
}
