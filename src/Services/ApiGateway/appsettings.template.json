{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "legacy-gps-lastposition-route": {
        "ClusterId": "delivery-tracking-cluster",
        "Order": 1,
        "Match": {
          "Path": "/gps-lastposition"
        }
      },
      "positions-route": {
        "ClusterId": "delivery-tracking-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/v1/positions/{**catch-all}"
        }
      },
      "vendors-route": {
        "ClusterId": "vendor-master-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/v1/vendors/{**catch-all}"
        }
      },
      "vendors-exact-route": {
        "ClusterId": "vendor-master-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/v1/vendors"
        }
      },
      "geofence-destinations-route": {
        "ClusterId": "vendor-master-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/v1/geofence-destinations/{**catch-all}"
        }
      },
      "geofence-destinations-exact-route": {
        "ClusterId": "vendor-master-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/v1/geofence-destinations"
        }
      },
      "deliveries-route": {
        "ClusterId": "delivery-tracking-cluster",
        "Order": 4,
        "Match": {
          "Path": "/api/v1/deliveries/{**catch-all}"
        }
      },
      "legacy-delivery-onprogress-route": {
        "ClusterId": "delivery-tracking-cluster",
        "Order": 4,
        "Match": {
          "Path": "/api/v1/RDeliveryOnProgress/{**catch-all}"
        }
      },
      "legacy-delivery-onprogress-exact-route": {
        "ClusterId": "delivery-tracking-cluster",
        "Order": 4,
        "Match": {
          "Path": "/api/v1/RDeliveryOnProgress"
        }
      },
      "legacy-track-delivery-route": {
        "ClusterId": "delivery-tracking-cluster",
        "Order": 4,
        "Match": {
          "Path": "/api/v1/gps-data-edcl/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "vendor-master-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://vendor-master-svc.edcl-prod.svc.cluster.local:8080"
          }
        }
      },
      "delivery-tracking-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://delivery-tracking-svc.edcl-prod.svc.cluster.local:8080"
          }
        }
      }
    }
  }
}
