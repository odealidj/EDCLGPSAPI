{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "GeofenceWorker": "Information"
    }
  },
  "Worker": {
    "Enabled": true
  },
  "Alerts": {
    "MaxConsecutiveFailures": 3
  },
  "ConnectionStrings": {
    "Database": "Server=localhost;Port=5436;Database=AE031_EDCL_GPS_DB;User Id=postgres;Password=${DB_PASSWORD};Include Error Detail=true;Timezone=Asia/Jakarta;",
    "Redis": "localhost:6379"
  },
  "MongoDb": {
    "ConnectionString": "mongodb://${MONGO_USERNAME}:${MONGO_PASSWORD}@localhost:27017/?authSource=admin",
    "DatabaseName": "edcl_logs_db",
    "ApiLogsCollection": "gps_api_logs",
    "RawResponsesCollection": "gps_raw_responses",
    "ApiLogTtlDays": 90,
    "RawResponseTtlDays": 30
  },
  "RabbitMq": {
    "Protocol": "amqp",
    "HostName": "localhost",
    "UserName": "guest",
    "Password": "${RABBITMQ_PASSWORD}",
    "Port": 5672,
    "VirtualHost": "/"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*"
}

